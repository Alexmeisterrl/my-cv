---
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import content from '../../CONTENT.json';

// QR-Code Platzhalter
---

<Layout title={`CV | ${content.name}`}>
  <ThemeToggle />
  <style is:global>
    @media print {
      @page {
        size: A4 portrait;
        margin: 0;
      }
      
      body { 
        background: white !important; 
        margin: 0 !important; 
        padding: 0 !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }

      nav, .no-print, .theme-toggle { display: none !important; }

      /* Jede Seite ist ein eigener Block */
      .cv-page {
        width: 210mm !important;
        height: 297mm !important;
        display: flex !important;
        page-break-after: always !important;
        break-after: page !important;
        overflow: hidden !important;
      }

      aside, .main-content {
        height: 100% !important;
      }
    }
  </style>

  <main class="min-h-screen bg-gray-100 dark:bg-gray-950 py-12 px-4 flex flex-col items-center gap-8 overflow-x-hidden print:bg-white print:py-0 print:px-0 print:block transition-colors duration-500">
    
    {/* Floating Action Bar */}
    <div class="max-w-[210mm] w-full flex justify-between items-center mb-4 no-print">
      <a href="/" class="group flex items-center gap-2 text-gray-600 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400 font-bold transition-colors">
        <svg class="w-5 h-5 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
        Zurück zum Portfolio
      </a>
      <button onclick="window.print()" class="bg-indigo-600 text-white px-8 py-3 rounded-2xl font-bold shadow-xl shadow-indigo-200 dark:shadow-none hover:bg-indigo-700 hover:scale-105 active:scale-95 transition-all flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
        PDF Speichern
      </button>
    </div>

    {/* SEITE 1 */}
    <div class="cv-page w-[210mm] h-[297mm] bg-white shadow-[0_0_60px_rgba(0,0,0,0.05)] dark:shadow-none flex print:m-0 print:shadow-none">
      <aside class="w-[31%] bg-[#1a1c23] text-white flex flex-col p-10 print:p-12 print:bg-[#1a1c23] shrink-0 self-stretch">
        <div class="mb-12 text-center">
          <div class="w-full aspect-square rounded-3xl overflow-hidden mb-8 border-4 border-white/10 shadow-2xl rotate-2">
            <img src="/profile.jpg" alt={content.name} class="w-full h-full object-cover grayscale-[10%]" />
          </div>
          <h2 class="text-2xl font-black tracking-tight mb-2 uppercase">{content.name}</h2>
          <p class="text-indigo-400 text-sm font-black uppercase tracking-widest leading-tight">{content.role}</p>
        </div>

        <div class="space-y-8 mb-12">
          <h3 class="text-[11px] font-black uppercase tracking-[0.3em] text-gray-500 border-b border-white/10 pb-3">Kontakt</h3>
          <ul class="space-y-5">
            <li class="flex items-center gap-4">
              <div class="p-2 bg-white/5 rounded-xl text-indigo-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <span class="text-[12px] text-gray-300 font-medium whitespace-nowrap">{content.links.email}</span>
            </li>
            <li class="flex items-center gap-4">
              <div class="p-2 bg-white/5 rounded-xl text-indigo-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <span class="text-[12px] text-gray-300 font-medium">{content.location}</span>
            </li>
            <li class="flex items-center gap-4">
              <div class="p-2 bg-white/5 rounded-xl text-indigo-400">
                 <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.43.372.823 1.102.823 2.222 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
              </div>
              <span class="text-[12px] text-gray-300 font-medium">Alexmeisterrl</span>
            </li>
          </ul>
        </div>

        <div class="mb-12">
          <h3 class="text-[11px] font-black uppercase tracking-[0.3em] text-gray-500 border-b border-white/10 pb-3 mb-6">Sprachen</h3>
          <div class="space-y-5">
            {content.languages.map((lang) => (
              <div>
                <div class="flex justify-between text-[13px] font-bold mb-2">
                  <span>{lang.name}</span>
                  <span class="text-indigo-400">{lang.level}</span>
                </div>
                <div class="w-full h-1.5 bg-white/5 rounded-full overflow-hidden">
                  <div class={`h-full bg-indigo-500 shadow-[0_0_10px_rgba(99,102,241,0.5)] ${lang.level.includes('Muttersprache') || lang.level.includes('C2') ? 'w-full' : 'w-1/2'}`}></div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </aside>

      <div class="main-content flex-1 flex flex-col pt-10 pb-16 px-10 print:pt-12 print:px-16 bg-white self-stretch">
        <div class="mb-10 pb-10 border-b-2 border-gray-50">
          <h1 class="text-[52px] font-black text-gray-900 leading-[0.9] tracking-tighter uppercase mb-4">
            {content.name.split(' ')[0]}<br/>
            <span class="text-indigo-600">{content.name.split(' ').slice(1).join(' ')}</span>
          </h1>
          <p class="text-xl font-bold text-gray-400 mb-6 uppercase tracking-[0.3em]">{content.role}</p>
          <p class="text-[15px] text-gray-600 leading-relaxed font-medium">"{content.about}"</p>
        </div>

        <section>
          <h3 class="text-sm font-black uppercase tracking-[0.3em] text-gray-900 mb-8 flex items-center gap-6">
            Berufsweg <span class="flex-1 h-px bg-gray-100"></span>
          </h3>
          <div class="space-y-10">
            {content.experience.map((exp) => (
              <div class="experience-item flex gap-8">
                <div class="text-[11px] font-black text-indigo-300 uppercase w-28 shrink-0 pt-1.5 tracking-wider">{exp.duration}</div>
                <div>
                  <h4 class="text-[17px] font-black text-gray-900 mb-1 uppercase tracking-tight">{exp.position}</h4>
                  <div class="text-indigo-600 text-[13px] font-bold mb-3 uppercase tracking-wide">{exp.company} • {exp.location}</div>
                  <p class="text-[14px] text-gray-500 leading-relaxed">{exp.description}</p>
                </div>
              </div>
            ))}
          </div>
        </section>
      </div>
    </div>

    {/* SEITE 2 */}
    <div class="cv-page w-[210mm] h-[297mm] bg-white shadow-[0_0_60px_rgba(0,0,0,0.05)] flex print:m-0 print:shadow-none">
      <aside class="w-[31%] bg-[#1a1c23] text-white flex flex-col pt-10 pb-10 px-10 print:pt-12 print:px-12 print:bg-[#1a1c23] shrink-0 self-stretch">
        <div class="mb-12">
          <h3 class="text-[11px] font-black uppercase tracking-[0.3em] text-gray-500 border-b border-white/10 pb-3 mb-6">Interessen</h3>
          <div class="flex flex-wrap gap-2.5">
            {content.interests.map((interest) => (
              <span class="text-[12px] text-gray-400 font-medium italic border border-white/5 px-3 py-1 rounded-lg">{interest}</span>
            ))}
          </div>
        </div>

        <div class="mt-auto text-center bg-white/5 p-6 rounded-3xl border border-white/10 shadow-inner">
          <div class="w-24 h-24 mx-auto bg-white p-2.5 rounded-2xl mb-4 shadow-2xl shadow-black/20">
             <img src="/qrcode.png" alt="Portfolio QR Code" class="w-full h-full object-contain" />
          </div>
          <p class="text-[9px] font-black uppercase tracking-[0.2em] text-indigo-300 leading-tight">Portfolio & AI Demo</p>
        </div>
      </aside>

      <div class="main-content flex-1 flex flex-col pt-10 pb-16 px-16 print:pt-12 print:px-20 bg-white self-stretch">
        <section class="mb-12">
          <h3 class="text-sm font-black uppercase tracking-[0.3em] text-gray-900 mb-8 flex items-center gap-6">
            Ausbildung <span class="flex-1 h-px bg-gray-100"></span>
          </h3>
          <div class="space-y-8">
            {content.education.map((edu) => (
              <div class="education-item flex gap-8">
                <div class="text-[11px] font-black text-gray-300 uppercase w-28 shrink-0 pt-1.5 tracking-wider">{edu.duration}</div>
                <div>
                  <h4 class="text-[16px] font-bold text-gray-900 mb-1 uppercase tracking-tight">{edu.degree}</h4>
                  <div class="text-gray-500 text-[13px] font-bold uppercase tracking-wide">{edu.school} • {edu.location}</div>
                  {edu.description && <p class="text-[13px] text-gray-400 mt-2 italic">{edu.description}</p>}
                </div>
              </div>
            ))}
          </div>
        </section>

        <section>
          <h3 class="text-sm font-black uppercase tracking-[0.3em] text-gray-900 mb-8 flex items-center gap-6">
            Ausgewählte Projekte <span class="flex-1 h-px bg-gray-100"></span>
          </h3>
          <div class="grid grid-cols-2 gap-6">
            {content.projects.map((project) => (
              <div class="project-card p-6 bg-gray-50 rounded-2xl border border-gray-100 shadow-sm">
                <h4 class="text-[13px] font-black text-gray-900 mb-2 uppercase tracking-wider">{project.title}</h4>
                <p class="text-[12px] text-gray-500 mb-4 leading-relaxed line-clamp-3">{project.description}</p>
                <div class="flex flex-wrap gap-1.5">
                  {project.tech.map(t => (
                    <span class="text-[9px] font-bold text-indigo-600 uppercase bg-indigo-50 px-2 py-0.5 rounded-md border border-indigo-100/50">{t}</span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>
      </div>
    </div>
  </main>
</Layout>